// Esquema de base de datos de SIRX.
// Refleja el modelo entidad-relación del proyecto: personal/acceso
// (Colaborador, Rol, Plaza, Usuario), ubicación geográfica compartida
// (Pais, Departamento, Municipio), catálogo (Articulo, Categoria, Marca,
// Inventario, Modelo/Modelo_Compatible) y los dos flujos transaccionales
// simétricos de compras (Proveedor, Compra_Maestro/Detalle) y ventas
// (Cliente, Salida_Maestro/Detalle).
//
// Los nombres de tabla/columna se mapean explícitamente (@map/@@map) a
// los identificadores en minúscula que Postgres genera a partir del
// script original (los identificadores sin comillas se pliegan a
// minúsculas), para que coincidan exactamente con la base ya definida.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Colaborador {
  idColaborador Int      @id(map: "pk_colaborador") @map("id_colaborador")
  nombres       String
  primerApel    String   @map("primer_apel")
  segundoApel   String?  @map("segundo_apel")
  correo        String?
  numeroCelular String?  @map("numero_celular")
  fecTransac    DateTime @default(now()) @map("fec_transac")

  plazas            Plaza[]
  ingresoPlataforma IngresoPlataforma?
  usuario           Usuario?
  ventasRealizadas  SalidaMaestro[]
  comprasRealizadas CompraMaestro[]
  conteosCreados    ConteoFisico[] @relation("ConteoCreador")
  conteosCerrados   ConteoFisico[] @relation("ConteoCierre")

  @@map("colaborador")
}

model Rol {
  idRol       Int    @id(map: "pk_rol") @map("id_rol")
  descripcion String

  plazas Plaza[]

  @@map("rol")
}

model Plaza {
  idPlaza       Int       @id(map: "pk_plaza") @map("id_plaza")
  fechaInicio   DateTime  @map("fecha_inicio")
  fechaFin      DateTime? @map("fecha_fin")
  fecTransac    DateTime  @default(now()) @map("fec_transac")
  idRol         Int       @map("id_rol")
  idColaborador Int       @map("id_colaborador")

  rol         Rol         @relation(fields: [idRol], references: [idRol], map: "fk_plaza_rol")
  colaborador Colaborador @relation(fields: [idColaborador], references: [idColaborador], map: "fk_plaza_colaborador")

  @@map("plaza")
}

model Departamento {
  idDepartamento Int    @id(map: "pk_departamento") @map("id_departamento")
  nombre         String

  municipios  Municipio[]
  proveedores Proveedor[]
  clientes    Cliente[]

  @@map("departamento")
}

model Municipio {
  idMunicipio    Int    @id(map: "pk_municipio") @map("id_municipio")
  nombre         String
  idDepartamento Int    @map("id_departamento")

  departamento Departamento @relation(fields: [idDepartamento], references: [idDepartamento], map: "fk_municipio_departamento")
  proveedores  Proveedor[]
  clientes     Cliente[]

  @@map("municipio")
}

model Pais {
  idPais Int    @id(map: "pk_pais") @map("id_pais")
  nombre String

  proveedores Proveedor[]
  clientes    Cliente[]

  @@map("pais")
}

model Proveedor {
  idProveedor    Int     @id(map: "pk_proveedor") @map("id_proveedor")
  nombre         String
  direccion      String?
  vigente        Boolean @default(true)
  contacto       String?
  idMunicipio    Int?    @map("id_municipio")
  idDepartamento Int?    @map("id_departamento")
  idPais         Int     @map("id_pais")

  municipio    Municipio?      @relation(fields: [idMunicipio], references: [idMunicipio], map: "fk_proveedor_municipio")
  departamento Departamento?   @relation(fields: [idDepartamento], references: [idDepartamento], map: "fk_proveedor_departamento")
  pais         Pais            @relation(fields: [idPais], references: [idPais], map: "fk_proveedor_pais")
  compras      CompraMaestro[]
  articulos    Articulo[]

  @@map("proveedor")
}

model Categoria {
  idCategoria Int    @id(map: "pk_categoria") @map("id_categoria")
  descripcion String

  articulos Articulo[]
  conteos   ConteoFisico[]

  @@map("categoria")
}

model Marca {
  idMarca Int    @id(map: "pk_marca") @map("id_marca")
  nombre  String

  articulos Articulo[]

  @@map("marca")
}

// precioCosto/ubicacion/idProveedor no estaban en el modelo original: se
// agregaron para HU-04 (gestión del catálogo). precioCosto y el proveedor
// preferido de un repuesto son datos sensibles — el rol Operador nunca los
// recibe (ver articuloService.js, formatearArticulo).
model Articulo {
  sku              String  @id(map: "pk_articulo")
  nombre           String
  // Umbral de "stock bajo" PROPIO del producto. null = usa el umbral
  // general de `Configuracion` (clave `umbral_stock_bajo`). Regla efectiva
  // en un solo lugar: services/umbralStockService.js.
  inventarioMinimo Int?    @map("inventario_minimo")
  precioVenta      Decimal @map("precio_venta") @db.Decimal
  precioCosto      Decimal @map("precio_costo") @db.Decimal
  ubicacion        String?
  estado           Boolean @default(true)
  idCategoria      Int     @map("id_categoria")
  idMarca          Int?    @map("id_marca")
  idProveedor      Int?    @map("id_proveedor")

  categoria          Categoria          @relation(fields: [idCategoria], references: [idCategoria], map: "fk_articulo_categoria")
  marca              Marca?             @relation(fields: [idMarca], references: [idMarca], map: "fk_articulo_marca")
  proveedor          Proveedor?         @relation(fields: [idProveedor], references: [idProveedor], map: "fk_articulo_proveedor")
  inventario         Inventario?
  modelosCompatibles ModeloCompatible[]
  salidaDetalles     SalidaDetalle[]
  compraDetalles     CompraDetalle[]
  conteoDetalles     ConteoDetalle[]

  @@map("articulo")
}

model Inventario {
  cantidad   Int      @default(0)
  fecTransac DateTime @default(now()) @map("fec_transac")
  sku        String   @id(map: "pk_inventario")

  articulo Articulo @relation(fields: [sku], references: [sku], map: "fk_inventario_articulo")

  @@map("inventario")
}

// Configuración global clave/valor (valor como texto). Hoy solo guarda
// `umbral_stock_bajo`: el umbral por defecto de "stock bajo" para todo el
// catálogo, editable solo por Administrador.
model Configuracion {
  clave      String   @id(map: "pk_configuracion")
  valor      String
  fecTransac DateTime @default(now()) @map("fec_transac")

  @@map("configuracion")
}

model Cliente {
  idCliente      Int     @id(map: "pk_cliente") @map("id_cliente")
  nombre         String
  direccion      String?
  contacto       String?
  idDepartamento Int?    @map("id_departamento")
  idMunicipio    Int?    @map("id_municipio")
  idPais         Int     @map("id_pais")

  departamento Departamento?   @relation(fields: [idDepartamento], references: [idDepartamento], map: "fk_cliente_departamento")
  municipio    Municipio?      @relation(fields: [idMunicipio], references: [idMunicipio], map: "fk_cliente_municipio")
  pais         Pais            @relation(fields: [idPais], references: [idPais], map: "fk_cliente_pais")
  ventas       SalidaMaestro[]

  @@map("cliente")
}

model TipoSalida {
  idTipoSalida Int    @id(map: "pk_tipo_salida") @map("id_tipo_salida")
  descripcion  String

  salidas SalidaDetalle[]

  @@map("tipo_salida")
}

model SalidaMaestro {
  idVenta         Int       @id(map: "pk_salida_maestro") @map("id_venta")
  fechaSalida     DateTime  @map("fecha_salida")
  fechaPago       DateTime? @map("fecha_pago")
  montoTotalVenta Decimal?  @map("monto_total_venta") @db.Decimal
  idColaborador   Int       @map("id_colaborador")
  idCliente       Int?      @map("id_cliente")
  // Baja lógica de una venta (nunca se borra el registro): Administrador
  // puede anularla, lo que restaura el stock de cada línea en la misma
  // transacción. Se excluye de comparación de ventas y de cualquier
  // reporte que sume ventas (dashboardService.js), pero sigue visible en
  // el historial con el badge "Anulada".
  anulada         Boolean   @default(false)

  colaborador Colaborador     @relation(fields: [idColaborador], references: [idColaborador], map: "fk_salidamaestro_colaborador")
  cliente     Cliente?        @relation(fields: [idCliente], references: [idCliente], map: "fk_salidamaestro_cliente")
  detalles    SalidaDetalle[]

  @@map("salida_maestro")
}

// HU-13: una salida (venta o ajuste/merma) puede tener varias líneas de
// producto — por eso idDetalleSalida es su propia PK y idSalida es una FK
// normal (no compartida) hacia el maestro. Antes de esta migración era 1—1.
//
// idTipoSalida vive acá (no en SalidaMaestro) desde la migración
// `20260914000000_...`: cada línea de un ajuste puede tener su propio
// motivo (Merma/Uso interno/Garantía/Ajuste) — antes era un solo motivo
// por todo el registro. Una venta (HU-13) sigue escribiendo el mismo
// idTipoSalida=1 (Venta) en todas sus líneas, así que "es esto una venta o
// un ajuste" se sigue pudiendo determinar por línea, o por el conjunto de
// líneas del maestro (ver ventaService.js/salidaAjusteService.js).
model SalidaDetalle {
  idDetalleSalida Int      @id(map: "pk_salida_detalle") @map("id_detalle_salida")
  cantidad        Int
  precioVenta     Decimal? @map("precio_venta") @db.Decimal
  fecCompra       DateTime @map("fec_compra")
  idSalida        Int      @map("id_salida")
  sku             String
  idTipoSalida    Int      @map("id_tipo_salida")

  salidaMaestro SalidaMaestro @relation(fields: [idSalida], references: [idVenta], map: "fk_salidadetalle_salidamaestro")
  articulo      Articulo      @relation(fields: [sku], references: [sku], map: "fk_salidadetalle_articulo")
  tipoSalida    TipoSalida    @relation(fields: [idTipoSalida], references: [idTipoSalida], map: "fk_salidadetalle_tiposalida")

  @@map("salida_detalle")
}

model CompraMaestro {
  idCompra         Int       @id(map: "pk_compra_maestro") @map("id_compra")
  fechaCompra      DateTime  @map("fecha_compra")
  fechaPago        DateTime? @map("fecha_pago")
  montoTotalCompra Decimal   @map("monto_total_compra") @db.Decimal
  idColaborador    Int       @map("id_colaborador")
  idProveedor      Int       @map("id_proveedor")
  // Baja lógica de una compra (nunca se borra el registro): Administrador
  // puede anularla, lo que decrementa el stock de cada línea en la misma
  // transacción — mismo patrón que SalidaMaestro.anulada para ventas/ajustes.
  anulada          Boolean   @default(false)

  colaborador Colaborador     @relation(fields: [idColaborador], references: [idColaborador], map: "fk_compramaestro_colaborador")
  proveedor   Proveedor       @relation(fields: [idProveedor], references: [idProveedor], map: "fk_compramaestro_proveedor")
  detalles    CompraDetalle[]

  @@map("compra_maestro")
}

// HU-08: una compra puede traer varios SKUs — mismo cambio 1—1 -> 1—N que
// SalidaDetalle, y por la misma razón (idDetalleCompra PK propia, idCompra
// FK normal hacia el maestro).
model CompraDetalle {
  idDetalleCompra Int      @id(map: "pk_compra_detalle") @map("id_detalle_compra")
  precioCompra    Decimal  @map("precio_compra") @db.Decimal
  cantidad        Int
  fecCompra       DateTime @map("fec_compra")
  idCompra        Int      @map("id_compra")
  sku             String

  compraMaestro CompraMaestro @relation(fields: [idCompra], references: [idCompra], map: "fk_compradetalle_compramaestro")
  articulo      Articulo      @relation(fields: [sku], references: [sku], map: "fk_compradetalle_articulo")

  @@map("compra_detalle")
}

model IngresoPlataforma {
  fecIngreso    DateTime @map("fec_ingreso")
  idColaborador Int      @id(map: "pk_ingreso_plataforma") @map("id_colaborador")

  colaborador Colaborador @relation(fields: [idColaborador], references: [idColaborador], map: "fk_ingresoplataforma_colaborador")

  @@map("ingreso_plataforma")
}

// El login (HU-01) usa esta tabla. failedAttempts/lockedUntil se agregaron
// sobre el modelo original para soportar el bloqueo temporal de cuenta.
model Usuario {
  usuario        String    @unique(map: "uq_usuario_usuario")
  contrasena     String    @map("contraseña")
  vigente        Boolean   @default(true)
  fecTransac     DateTime  @default(now()) @map("fec_transac")
  idColaborador  Int       @id(map: "pk_usuario") @map("id_colaborador")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")

  colaborador Colaborador @relation(fields: [idColaborador], references: [idColaborador], map: "fk_usuario_colaborador")

  @@map("usuario")
}

model Modelo {
  idModelo    Int    @id(map: "pk_modelo") @map("id_modelo")
  descripcion String

  compatibles ModeloCompatible[]

  @@map("modelo")
}

model ModeloCompatible {
  sku      String
  idModelo Int    @map("id_modelo")

  articulo Articulo @relation(fields: [sku], references: [sku], map: "fk_modelocompatible_articulo")
  modelo   Modelo   @relation(fields: [idModelo], references: [idModelo], map: "fk_modelocompatible_modelo")

  @@id([sku, idModelo], map: "pk_modelo_compatible")
  @@map("modelo_compatible")
}

// Conteo físico de inventario (acta del proyecto: diferencia <= 5 % entre
// sistema y conteo). Estados: borrador -> aplicado (se cerró y se corrigió
// Inventario) | cerrado (se cerró SIN corregir, solo informe) | cancelado.
// Un conteo no borrador es inmutable. idCategoria NULL = todo el catálogo.
// Reglas de concurrencia y de ajuste: services/conteoService.js.
model ConteoFisico {
  idConteo            Int       @id(map: "pk_conteo_fisico") @map("id_conteo")
  nombre              String
  fechaConteo         DateTime  @map("fecha_conteo")
  estado              String    @default("borrador")
  idCategoria         Int?      @map("id_categoria")
  idColaborador       Int       @map("id_colaborador")
  idColaboradorCierre Int?      @map("id_colaborador_cierre")
  fechaCierre         DateTime? @map("fecha_cierre")
  fecTransac          DateTime  @default(now()) @map("fec_transac")

  categoria Categoria?       @relation(fields: [idCategoria], references: [idCategoria], map: "fk_conteo_categoria")
  creador   Colaborador      @relation("ConteoCreador", fields: [idColaborador], references: [idColaborador], map: "fk_conteo_colaborador")
  cierre    Colaborador?     @relation("ConteoCierre", fields: [idColaboradorCierre], references: [idColaborador], map: "fk_conteo_colaborador_cierre")
  detalles  ConteoDetalle[]

  @@map("conteo_fisico")
}

// Una línea por SKU contado. cantidadSistema = stock registrado en el
// momento de contar (se refresca si el SKU se vuelve a contar). Al aplicar,
// `ajuste` = contada - cantidadSistema se SUMA al stock vigente (no se
// pisa), de modo que las ventas ocurridas durante el conteo no se pierden;
// cantidadAntes/cantidadDespues guardan el stock real antes/después.
model ConteoDetalle {
  idDetalleConteo Int      @id(map: "pk_conteo_detalle") @map("id_detalle_conteo")
  idConteo        Int      @map("id_conteo")
  sku             String
  cantidadSistema Int      @map("cantidad_sistema")
  cantidadContada Int      @map("cantidad_contada")
  fecContado      DateTime @default(now()) @map("fec_contado")
  ajuste          Int?
  cantidadAntes   Int?     @map("cantidad_antes")
  cantidadDespues Int?     @map("cantidad_despues")

  conteo   ConteoFisico @relation(fields: [idConteo], references: [idConteo], onDelete: Cascade, map: "fk_conteodetalle_conteo")
  articulo Articulo     @relation(fields: [sku], references: [sku], map: "fk_conteodetalle_articulo")

  @@unique([idConteo, sku], map: "uq_conteo_detalle_sku")
  @@map("conteo_detalle")
}
