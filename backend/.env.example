# Connection string de PostgreSQL (Neon en producción, local en desarrollo)
DATABASE_URL="postgresql://user:password@localhost:5432/sirx?schema=public"

# Puerto del servidor (Render lo sobreescribe en producción)
PORT=3000

# Secreto para firmar JWT. Mínimo 32 caracteres (T-105): el servidor no
# arranca si es más corto. Generar uno propio, por ejemplo con
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET="cambia-esto-por-un-secreto-real-de-al-menos-32-caracteres"

# Tiempo de expiración de la sesión (formato de la librería jsonwebtoken).
# Política de sesión corta (T-105): debe estar entre 1m y 1h, el servidor
# no arranca fuera de ese rango.
JWT_EXPIRES_IN=30m

# Intentos fallidos permitidos antes de bloquear la cuenta
MAX_LOGIN_ATTEMPTS=3

# Minutos que dura el bloqueo temporal de una cuenta
LOCKOUT_MINUTES=15

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN="http://localhost:5173"

# Contraseñas de los usuarios de prueba creados por `npm run prisma:seed`.
# Requeridas: el seed falla si faltan (no hay contraseña por defecto
# hardcodeada en el repo). Usa valores propios, no los de este ejemplo.
# Deben cumplir la política de contraseñas (T-104): mínimo 8 caracteres,
# con mayúscula, minúscula, número y símbolo.
ADMIN_PASSWORD="Change-me8!"
OPERADOR_PASSWORD="Change-me8!"
